{
  "name": "@tinfoilsh/noise",
  "version": "0.1.0",
  "description": "Noise Protocol Framework handshakes and transports for Noise_*_25519_ChaChaPoly_BLAKE2s",
  "license": "MIT",
  "type": "module",
  "packageManager": "bun@1.4.3",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rm -rf dist && bun build src/index.ts --outdir dist --target browser --format esm --packages external && tsc -p tsconfig.build.json",
    "check": "tsc --noEmit",
    "smoke": "bun run build && bun scripts/smoke.ts",
    "test": "bun test"
  },
  "dependencies": {
    "@noble/ciphers": "2.4.0",
    "@noble/curves": "2.4.0",
    "@noble/hashes": "2.4.0"
  },
  "devDependencies": {
    "@types/bun": "1.4.3",
    "typescript": "7.0.2"
  },
  "prettier": {
    "printWidth": 120
  }
}
